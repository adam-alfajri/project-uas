---
const hasError = Astro.url.searchParams.has('error');
const tabs = [
  {
    id: 'ap',
    label: 'Account Payable',
    title: 'Hutang usaha',
    text: 'Catat tagihan dari vendor, lacak jatuh tempo, dan saring berdasarkan periode, customer, sales, serta status.',
    tags: ['Rentang tanggal', 'Customer', 'Sales', 'Status'],
  },
  {
    id: 'ar',
    label: 'Account Receivable',
    title: 'Piutang usaha',
    text: 'Pantau tagihan ke customer, status pembayaran, dan riwayat penagihan dalam satu daftar yang bisa difilter.',
    tags: ['Rentang tanggal', 'Customer', 'Sales', 'Status'],
  },
  {
    id: 'fr',
    label: 'Financial Report',
    title: 'Laporan keuangan',
    text: 'Forecasting, laba rugi, dan arus kas, dihitung langsung dari data AP dan AR yang sudah diimpor.',
    tags: ['Forecasting', 'Laba rugi', 'Arus kas'],
  },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in | Fajri Finance</title>
    <style>
      :root {
        --ink: #111111;
        --ink-2: #3b3b3b;
        --muted: #6e6e6e;
        --faint: #a0a0a0;
        --line: #e4e4e4;
        --line-strong: #c9c9c9;
        --paper: #ffffff;
        --canvas: #f4f4f2;
        --error: #b42318;
        --error-bg: #fef3f2;
        --error-line: #fecdca;
        --serif: 'Newsreader', Georgia, 'Times New Roman', serif;
        --sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      * { box-sizing: border-box; }

      html, body { height: 100%; margin: 0; }

      body {
        font-family: var(--sans);
        font-size: 14px;
        line-height: 1.5;
        color: var(--ink);
        background: var(--paper);
        -webkit-font-smoothing: antialiased;
      }

      .shell {
        height: 100vh;
        height: 100dvh;
        display: grid;
        grid-template-columns: 1fr 1fr;
      }

      /* ---------- Panel visual ---------- */
      .visual {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 32px 40px;
        background: var(--canvas);
        overflow: hidden;
        isolation: isolate;
      }

      /* Pola titik halftone, dipudarkan ke tepi */
      .visual::before {
        content: '';
        position: absolute;
        inset: -10%;
        z-index: -1;
        background-image: radial-gradient(circle, #151515 1.1px, transparent 1.4px);
        background-size: 14px 14px;
        opacity: 0.12;
        -webkit-mask-image: radial-gradient(ellipse 60% 55% at 45% 45%, #000 20%, transparent 72%);
        mask-image: radial-gradient(ellipse 60% 55% at 45% 45%, #000 20%, transparent 72%);
        animation: breathe 14s ease-in-out infinite alternate;
      }

      @keyframes breathe {
        from { opacity: 0.08; transform: scale(1); }
        to { opacity: 0.16; transform: scale(1.03); }
      }

      .brand {
        font-size: 14px;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .stage {
        position: relative;
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 0;
      }

      /* Kartu utama: tab interaktif */
      .card {
        position: relative;
        width: min(100%, 440px);
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 18px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 24px 48px -28px rgba(0, 0, 0, 0.22);
        animation: float 9s ease-in-out infinite;
      }

      @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
      }

      .tabs {
        position: relative;
        display: flex;
        gap: 4px;
        padding: 4px;
        background: var(--canvas);
        border-radius: 9px;
        margin-bottom: 18px;
      }

      .tab {
        position: relative;
        z-index: 1;
        flex: 1;
        font: inherit;
        font-size: 12.5px;
        font-weight: 500;
        color: var(--muted);
        background: none;
        border: none;
        padding: 8px 6px;
        border-radius: 7px;
        cursor: pointer;
        white-space: nowrap;
        transition: color 0.25s var(--ease);
      }

      .tab:hover { color: var(--ink); }
      .tab[aria-selected='true'] { color: var(--ink); }

      .tab:focus-visible {
        outline: 1px solid var(--ink);
        outline-offset: 1px;
      }

      .tab-indicator {
        position: absolute;
        top: 4px;
        bottom: 4px;
        left: 4px;
        background: var(--paper);
        border-radius: 7px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
        transition: transform 0.45s var(--ease), width 0.45s var(--ease);
      }

      .panel { display: none; }
      .panel.active { display: block; animation: swap 0.5s var(--ease); }

      @keyframes swap {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .panel-title {
        margin: 0 0 6px;
        font-family: var(--serif);
        font-size: 20px;
        font-weight: 500;
        letter-spacing: -0.01em;
      }

      .panel-text {
        margin: 0 0 16px;
        font-size: 13px;
        color: var(--ink-2);
        line-height: 1.6;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .tag {
        font-size: 12px;
        color: var(--ink-2);
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        padding: 4px 10px;
        background: var(--paper);
        transition: background 0.25s, color 0.25s, border-color 0.25s;
      }

      .tag:hover { border-color: var(--ink); }

      .tag.on {
        background: var(--ink);
        color: var(--paper);
        border-color: var(--ink);
      }

      /* Kartu kecil melayang di pojok panel */
      .float-tag {
        position: absolute;
        right: -8px;
        bottom: 12%;
        padding: 10px 14px;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 10px;
        box-shadow: 0 16px 32px -20px rgba(0, 0, 0, 0.25);
        font-size: 12px;
        color: var(--ink-2);
        animation: float 7s ease-in-out infinite reverse;
      }

      .float-tag strong {
        display: block;
        font-size: 13px;
        color: var(--ink);
        font-weight: 600;
      }

      .caption {
        position: relative;
        margin: 0 0 8px;
        font-family: var(--serif);
        font-size: 30px;
        line-height: 1.12;
        letter-spacing: -0.02em;
        font-weight: 500;
      }

      .caption-sub {
        position: relative;
        margin: 0;
        font-size: 13px;
        color: var(--muted);
      }

      .foot {
        position: relative;
        margin-top: 24px;
      }

      /* ---------- Panel form ---------- */
      .form-side {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        background: var(--paper);
      }

      .form-wrap {
        width: 100%;
        max-width: 340px;
        animation: enter 0.5s var(--ease) both;
      }

      @keyframes enter {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
      }

      h1 {
        margin: 0 0 6px;
        font-family: var(--serif);
        font-size: 30px;
        font-weight: 500;
        letter-spacing: -0.02em;
      }

      .subtitle {
        margin: 0 0 28px;
        font-size: 13px;
        color: var(--muted);
      }

      .alert {
        margin-bottom: 18px;
        padding: 10px 12px;
        font-size: 13px;
        color: var(--error);
        background: var(--error-bg);
        border: 1px solid var(--error-line);
        border-radius: 8px;
      }

      .field { margin-bottom: 16px; }

      label {
        display: block;
        margin-bottom: 6px;
        font-size: 12.5px;
        font-weight: 500;
        color: var(--ink-2);
      }

      .input {
        width: 100%;
        height: 44px;
        padding: 0 14px;
        font: inherit;
        font-size: 16px; /* 16px mencegah zoom otomatis di iOS */
        color: var(--ink);
        background: var(--paper);
        border: 1px solid var(--line-strong);
        border-radius: 10px;
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      .input::placeholder { color: var(--faint); }
      .input:hover { border-color: #aaa; }

      .input:focus {
        outline: none;
        border-color: var(--ink);
        box-shadow: 0 0 0 3px rgba(17, 17, 17, 0.08);
      }

      .password-wrap { position: relative; }
      .password-wrap .input { padding-right: 60px; }

      .toggle {
        position: absolute;
        right: 6px;
        top: 50%;
        transform: translateY(-50%);
        height: 30px;
        padding: 0 8px;
        font: inherit;
        font-size: 12px;
        font-weight: 500;
        color: var(--muted);
        background: none;
        border: none;
        border-radius: 6px;
        cursor: pointer;
      }

      .toggle:hover { color: var(--ink); background: var(--canvas); }

      .toggle:focus-visible {
        outline: 1px solid var(--ink);
        outline-offset: 1px;
      }

      .btn {
        position: relative;
        overflow: hidden;
        width: 100%;
        height: 46px;
        margin-top: 8px;
        font: inherit;
        font-size: 14px;
        font-weight: 500;
        color: var(--paper);
        background: var(--ink);
        border: 1px solid var(--ink);
        border-radius: 10px;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s var(--ease);
      }

      .btn::after {
        content: '';
        position: absolute;
        top: 0;
        left: -70%;
        width: 40%;
        height: 100%;
        background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.18), transparent);
        transform: skewX(-18deg);
        transition: left 0.7s var(--ease);
      }

      .btn:hover:not(:disabled)::after { left: 130%; }
      .btn:hover:not(:disabled) { background: #2a2a2a; }
      .btn:active:not(:disabled) { transform: scale(0.99); }

      .btn:focus-visible {
        outline: 1px solid var(--ink);
        outline-offset: 2px;
      }

      .btn:disabled { opacity: 0.55; cursor: wait; }

      .help {
        margin: 22px 0 0;
        padding-top: 18px;
        font-size: 12.5px;
        color: var(--muted);
        text-align: center;
        border-top: 1px solid var(--line);
      }

      @media (max-width: 900px) {
        .shell { grid-template-columns: 1fr; height: auto; min-height: 100vh; }
        .visual { display: none; }
        .form-side { min-height: 100vh; padding: 24px; }
      }

      @media (max-height: 720px) {
        .card { padding: 14px; }
        .caption { font-size: 26px; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <section class="visual" aria-hidden="true">
        <div class="brand">Fajri Finance</div>

        <div class="stage">
          <div class="card">
            <div class="tabs" role="tablist" id="tabs">
              <span class="tab-indicator" id="indicator"></span>
              {tabs.map((t, i) => (
                <button
                  class="tab"
                  role="tab"
                  type="button"
                  data-index={i}
                  aria-selected={i === 0 ? 'true' : 'false'}
                >
                  {t.label}
                </button>
              ))}
            </div>

            {tabs.map((t, i) => (
              <div class={i === 0 ? 'panel active' : 'panel'} data-panel={i}>
                <h3 class="panel-title">{t.title}</h3>
                <p class="panel-text">{t.text}</p>
                <div class="tags">
                  {t.tags.map((tag, j) => (
                    <span class={j === 0 ? 'tag on' : 'tag'}>{tag}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <div class="float-tag">
            <strong>Sinkron</strong>
            Data terakhir diperbarui hari ini
          </div>
        </div>

        <div class="foot">
          <p class="caption">Pencatatan dan laporan keuangan dalam satu sistem.</p>
          <p class="caption-sub">Akses ke setiap modul mengikuti peran akun Anda.</p>
        </div>
      </section>

      <section class="form-side">
        <div class="form-wrap">
          <h1>Sign in</h1>
          <p class="subtitle">Use the account provided by your administrator.</p>

          {hasError && (
            <div class="alert" role="alert">The email or password is incorrect.</div>
          )}

          <form id="login-form" method="POST" action="/api/auth/login" novalidate>
            <div class="field">
              <label for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                class="input"
                placeholder="Enter your email"
                autocomplete="email"
                required
                autofocus
              />
            </div>

            <div class="field">
              <label for="password">Password</label>
              <div class="password-wrap">
                <input
                  id="password"
                  name="password"
                  type="password"
                  class="input"
                  placeholder="Enter your password"
                  autocomplete="current-password"
                  required
                />
                <button type="button" class="toggle" id="toggle-password" aria-label="Show password">
                  Show
                </button>
              </div>
            </div>

            <button type="submit" class="btn" id="submit-btn">Sign in</button>
          </form>

          <p class="help">Don't have an account? Contact your administrator.</p>
        </div>
      </section>
    </div>

    <script>
      // ----- Tab interaktif di kartu utama -----
      const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
      const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));
      const indicator = document.getElementById('indicator') as HTMLElement;
      const tagGroups = panels.map((p) => Array.from(p.querySelectorAll<HTMLElement>('.tag')));

      function moveIndicator(btn: HTMLButtonElement) {
        indicator.style.width = `${btn.offsetWidth}px`;
        indicator.style.transform = `translateX(${btn.offsetLeft - 4}px)`;
      }

      function activate(index: number) {
        tabButtons.forEach((b, i) => b.setAttribute('aria-selected', i === index ? 'true' : 'false'));
        panels.forEach((p, i) => p.classList.toggle('active', i === index));
        moveIndicator(tabButtons[index]);
      }

      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => activate(Number(btn.dataset.index)));
      });

      // Chip filter bisa diklik dan berpindah status "on"
      tagGroups.forEach((tags) => {
        tags.forEach((tag) => {
          tag.style.cursor = 'pointer';
          tag.addEventListener('click', () => {
            tags.forEach((t) => t.classList.remove('on'));
            tag.classList.add('on');
          });
        });
      });

      requestAnimationFrame(() => activate(0));
      window.addEventListener('resize', () => {
        const active = tabButtons.findIndex((b) => b.getAttribute('aria-selected') === 'true');
        moveIndicator(tabButtons[active]);
      });

      // ----- Form login -----
      const form = document.getElementById('login-form') as HTMLFormElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const passwordInput = document.getElementById('password') as HTMLInputElement;
      const toggleBtn = document.getElementById('toggle-password') as HTMLButtonElement;

      form.addEventListener('submit', () => {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Signing in...';
      });

      window.addEventListener('pageshow', () => {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Sign in';
      });

      toggleBtn.addEventListener('click', () => {
        const show = passwordInput.type === 'password';
        passwordInput.type = show ? 'text' : 'password';
        toggleBtn.textContent = show ? 'Hide' : 'Show';
        toggleBtn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
      });
    </script>
  </body>
</html>