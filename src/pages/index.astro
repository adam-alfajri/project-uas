---
import AppLayout from "../layouts/AppLayout.astro";
import {
  apInvoices,
  arInvoices,
  type Invoice,
  type InvoiceStatus,
} from "../lib/data/dummy";
import {
  money,
  todayISO,
  todayLong,
  monthLabel,
  lastDayOfMonth,
  daysBetween,
} from "../lib/format";

const today = todayISO();
const all = [
  ...apInvoices.map((i) => ({ ...i, mod: "AP" as const })),
  ...arInvoices.map((i) => ({ ...i, mod: "AR" as const })),
];

const sum = (list: Invoice[]) => list.reduce((acc, i) => acc + i.amount, 0);
const byStatus = (s: InvoiceStatus) => sum(all.filter((i) => i.status === s));

const paidAmt = byStatus("Paid");
const openAmt = byStatus("Open");
const overdueAmt = byStatus("Overdue");
const everything = paidAmt + openAmt + overdueAmt;
const outstanding = openAmt + overdueAmt;

const openAR = sum(arInvoices.filter((i) => i.status !== "Paid"));
const openAP = sum(apInvoices.filter((i) => i.status !== "Paid"));
const net = openAR - openAP;
const openARCount = arInvoices.filter((i) => i.status !== "Paid").length;
const openAPCount = apInvoices.filter((i) => i.status !== "Paid").length;

const overdueList = all
  .filter((i) => i.status === "Overdue")
  .sort((a, b) => b.amount - a.amount);
const overdueCount = overdueList.length;
const overdueShare = outstanding
  ? Math.round((overdueAmt / outstanding) * 100)
  : 0;
const lateDays = (due: string) => Math.max(0, daysBetween(due, today));

const keys = [...new Set(all.map((i) => i.date.slice(0, 7)))].sort();
const issuedIn = (list: Invoice[], m: string) =>
  sum(list.filter((i) => i.date.startsWith(m)));

const cur = keys.at(-1) ?? "";
const prev = keys.at(-2) ?? "";
const curTotal = issuedIn(all, cur);
const prevTotal = prev ? issuedIn(all, prev) : 0;
const delta = prevTotal ? ((curTotal - prevTotal) / prevTotal) * 100 : null;
const curLabel = cur ? monthLabel(cur) : "—";
const prevLabel = prev ? monthLabel(prev) : "—";
const firstLabel = keys[0] ? monthLabel(keys[0]) : "";
const lastLabel = curLabel;

const series = keys.map((k) => ({
  key: k,
  label: monthLabel(k),
  end: lastDayOfMonth(k),
  ap: issuedIn(apInvoices, k),
  ar: issuedIn(arInvoices, k),
}));
const peak = Math.max(1, ...series.flatMap((s) => [s.ap, s.ar]));
const barH = (v: number) => Math.max(4, Math.round((v / peak) * 200));
const mio = (v: number) =>
  `${(v / 1_000_000).toLocaleString("id-ID", { maximumFractionDigits: 1 })} jt`;

const ring = (() => {
  let acc = 0;
  return [
    { key: "paid", label: "Paid", value: paidAmt },
    { key: "open", label: "Open", value: openAmt },
    { key: "overdue", label: "Overdue", value: overdueAmt },
  ].map((s) => {
    const share = everything ? (s.value / everything) * 100 : 0;
    const out = { ...s, share, start: acc };
    acc += share;
    return out;
  });
})();

const salesRows = [...new Set(all.map((i) => i.sales))]
  .map((name) => {
    const rows = all.filter((i) => i.sales === name);
    return {
      name,
      paid: sum(rows.filter((r) => r.status === "Paid")),
      open: sum(rows.filter((r) => r.status === "Open")),
      overdue: sum(rows.filter((r) => r.status === "Overdue")),
    };
  })
  .map((r) => ({ ...r, total: r.paid + r.open + r.overdue }))
  .sort((a, b) => b.total - a.total);
const salesPeak = Math.max(1, ...salesRows.map((r) => r.total));
const pctOf = (v: number) => (v / salesPeak) * 100;

const summary = overdueCount
  ? `${overdueCount} invoices are overdue, totalling ${money(overdueAmt)}. Receivables ${net >= 0 ? "exceed" : "trail"} payables by ${money(Math.abs(net))}.`
  : `Nothing is overdue. Receivables ${net >= 0 ? "exceed" : "trail"} payables by ${money(Math.abs(net))}.`;
---

<AppLayout
  title="Overview"
  section="Overview"
  meta={todayLong()}
  description={summary}
>
  <span slot="actions">
    {firstLabel} – {lastLabel}
  </span>

  <section class="kpis" aria-label="Key figures">
    <article class="kpi">
      <p class="k">Issued in {curLabel}</p>
      <p class="v">{money(curTotal)}</p>
      <p class={delta === null ? "d" : delta >= 0 ? "d up" : "d down"}>
        {delta === null
          ? "No earlier month to compare"
          : `${delta >= 0 ? "↑" : "↓"} ${Math.abs(delta).toFixed(1)}% vs ${prevLabel}`}
      </p>
    </article>

    <article class="kpi">
      <p class="k">Open receivables</p>
      <p class="v">{money(openAR)}</p>
      <p class="d">{openARCount} invoices</p>
    </article>

    <article class="kpi">
      <p class="k">Open payables</p>
      <p class="v">{money(openAP)}</p>
      <p class="d">{openAPCount} invoices</p>
    </article>

    <article class="kpi">
      <p class="k">Overdue</p>
      <p class="v">{money(overdueAmt)}</p>
      <p class="d">{overdueShare}% of outstanding</p>
    </article>
  </section>

  <div class="grid">
    <section class="panel span-2" aria-labelledby="activity">
      <header class="ph">
        <div>
          <h2 id="activity">Monthly activity</h2>
          <p>
            Invoices issued per month. Hover a column to read values, select a
            bar to open that period.
          </p>
        </div>
        <ul class="legend" aria-hidden="true">
          <li>
            <i class="sw ap"></i>Payables
          </li>
          <li>
            <i class="sw ar"></i>Receivables
          </li>
        </ul>
      </header>

      <div class="chart">
        {series.map((s, i) => (
          <div class="col" style={`--i: ${i}`}>
            <div class="pair">
              <a
                class="bar ap"
                href={`/ap?start=${s.key}-01&end=${s.end}`}
                style={`--h: ${barH(s.ap)}px`}
                aria-label={`Payables, ${s.label}: ${money(s.ap)}`}
              >
                <span class="tip">{mio(s.ap)}</span>
              </a>
              <a
                class="bar ar"
                href={`/ar?start=${s.key}-01&end=${s.end}`}
                style={`--h: ${barH(s.ar)}px`}
                aria-label={`Receivables, ${s.label}: ${money(s.ar)}`}
              >
                <span class="tip">{mio(s.ar)}</span>
              </a>
            </div>
            <span class="axis">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="panel" aria-labelledby="mix">
      <header class="ph">
        <div>
          <h2 id="mix">Status mix</h2>
          <p>Share of all invoices by amount</p>
        </div>
      </header>

      <div class="donut-wrap">
        <svg
          class="donut"
          viewBox="0 0 200 200"
          role="img"
          aria-label={`Paid ${money(paidAmt)}, open ${money(openAmt)}, overdue ${money(overdueAmt)}`}
        >
          <g transform="rotate(-90 100 100)">
            <circle class="track" cx="100" cy="100" r="80" pathLength="100" />
            {ring.map((s) => (
              <circle
                class={`seg is-${s.key}`}
                cx="100"
                cy="100"
                r="80"
                pathLength="100"
                stroke-dasharray={`${s.share} ${100 - s.share}`}
                stroke-dashoffset={-s.start}
              />
            ))}
          </g>
        </svg>
        <div class="donut-center">
          <strong>{all.length}</strong>
          <span>invoices</span>
        </div>
      </div>

      <ul class="mix">
        {ring.map((s) => (
          <li>
            <span class="mix-name">
              <i class={`sw is-${s.key}`}></i>
              {s.label}
            </span>
            <span class="mix-val">{Math.round(s.share)}%</span>
            <span class="mix-amt">{money(s.value)}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="panel span-2" aria-labelledby="sales">
      <header class="ph">
        <div>
          <h2 id="sales">By sales</h2>
          <p>Total invoiced per salesperson, split by status</p>
        </div>
        <ul class="legend" aria-hidden="true">
          <li>
            <i class="sw is-paid"></i>Paid
          </li>
          <li>
            <i class="sw is-open"></i>Open
          </li>
          <li>
            <i class="sw is-overdue"></i>Overdue
          </li>
        </ul>
      </header>

      <ul class="rows">
        {salesRows.map((r, i) => (
          <li style={`--i: ${i}`}>
            <div class="row-top">
              <span class="name">{r.name}</span>
              <span class="tot">{money(r.total)}</span>
            </div>
            <div
              class="stack"
              role="img"
              aria-label={`${r.name}: paid ${money(r.paid)}, open ${money(r.open)}, overdue ${money(r.overdue)}`}
            >
              <span class="s is-paid" style={`width: ${pctOf(r.paid)}%`}></span>
              <span class="s is-open" style={`width: ${pctOf(r.open)}%`}></span>
              <span
                class="s is-overdue"
                style={`width: ${pctOf(r.overdue)}%`}
              ></span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="panel" aria-labelledby="overdue">
      <header class="ph">
        <div>
          <h2 id="overdue">Overdue</h2>
          <p>
            {overdueCount} invoices · {money(overdueAmt)}
          </p>
        </div>
      </header>

      {overdueCount === 0 ? (
        <p class="quiet">No overdue invoices.</p>
      ) : (
        <ol class="late">
          {overdueList.slice(0, 5).map((o, i) => (
            <li style={`--i: ${i}`}>
              <a href={`/${o.mod.toLowerCase()}?status=Overdue`}>
                <span class="mod">{o.mod}</span>
                <span class="who">
                  <span class="cust">{o.customer}</span>
                  <span class="meta">
                    {o.id} · {lateDays(o.dueDate)} days late
                  </span>
                </span>
                <span class="amt">{money(o.amount)}</span>
              </a>
            </li>
          ))}
        </ol>
      )}

      {overdueCount > 5 && (
        <p class="more">
          <a href="/ap?status=Overdue">{overdueCount - 5} more in payables</a>
        </p>
      )}
    </section>
  </div>
</AppLayout>

<style>
  .kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    animation: rise 0.7s var(--ease) 0.05s both;
  }

  .kpi {
    padding: 22px 24px;
    background: var(--paper);
  }

  .kpi + .kpi {
    border-left: 1px solid var(--line);
  }

  .k {
    margin: 0 0 12px;
    font-size: 12px;
    color: var(--muted);
  }

  .v {
    margin: 0;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .d {
    margin: 8px 0 0;
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .d.up {
    color: var(--ink);
  }
  .d.down {
    color: var(--accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .panel {
    min-width: 0;
    padding: 24px 26px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    animation: rise 0.7s var(--ease) both;
  }

  .panel.span-2 {
    grid-column: span 2;
  }
  .panel:nth-child(2) {
    animation-delay: 0.1s;
  }
  .panel:nth-child(3) {
    animation-delay: 0.15s;
  }
  .panel:nth-child(4) {
    animation-delay: 0.2s;
  }

  .ph {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 24px;
  }

  .ph h2 {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 600;
  }

  .ph p {
    margin: 0;
    font-size: 12px;
    color: var(--muted);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .sw {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: #c4c4c4;
  }

  .sw.ar,
  .sw.is-open {
    background: var(--accent);
  }
  .sw.is-paid {
    background: #d6d6d6;
  }
  .sw.is-overdue {
    background: var(--ink);
  }

  /* ---------- Grafik bulanan ---------- */
  .chart {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(56px, 1fr);
    gap: 6px;
    overflow-x: auto;
  }

  .col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pair {
    width: 100%;
    height: 220px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 5px;
    border-bottom: 1px solid var(--line-strong);
  }

  .bar {
    position: relative;
    display: block;
    width: 14px;
    height: var(--h);
    border-radius: 3px 3px 0 0;
    transform-origin: bottom center;
    animation: grow-y 1s var(--ease) both;
    animation-delay: calc(var(--i, 0) * 80ms + 200ms);
    transition: opacity 0.35s ease;
  }

  .bar.ap {
    background: #c4c4c4;
  }
  .bar.ar {
    background: var(--accent);
  }

  .chart:hover .col:not(:hover) .bar {
    opacity: 0.3;
  }

  .bar:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }

  .tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translate(-50%, 4px);
    padding: 2px 6px;
    font-size: 11px;
    white-space: nowrap;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 4px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.4s var(--ease);
  }

  .col:hover .tip,
  .bar:focus-visible .tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .axis {
    margin-top: 10px;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ---------- Donut ---------- */
  .donut-wrap {
    position: relative;
    width: 200px;
    height: 200px;
    margin: 4px auto 0;
  }

  .donut {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .donut circle {
    fill: none;
    stroke-width: 16;
  }

  .donut .track {
    stroke: var(--wash);
  }
  .donut .seg {
    transition: stroke-width 0.3s ease;
  }
  .donut .seg.is-paid {
    stroke: #d6d6d6;
  }
  .donut .seg.is-open {
    stroke: var(--accent);
  }
  .donut .seg.is-overdue {
    stroke: var(--ink);
  }

  .donut-wrap:hover .seg {
    stroke-width: 14;
  }
  .donut-wrap:hover .seg:hover {
    stroke-width: 18;
  }

  .donut-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .donut-center strong {
    font-size: 30px;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .donut-center span {
    font-size: 12px;
    color: var(--muted);
  }

  .mix {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .mix li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 16px;
    align-items: center;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-size: 13px;
  }

  .mix-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .mix-val {
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }

  .mix-amt {
    min-width: 110px;
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  /* ---------- Bar bertumpuk per sales ---------- */
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .row-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 8px;
    font-size: 13px;
  }

  .row-top .name {
    font-weight: 500;
  }

  .row-top .tot {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .stack {
    display: flex;
    height: 8px;
    border-radius: 999px;
    overflow: hidden;
    background: var(--wash);
  }

  .s {
    display: block;
    height: 100%;
    transform-origin: left center;
    animation: grow-x 1s var(--ease) both;
    animation-delay: calc(var(--i, 0) * 90ms + 200ms);
    transition: filter 0.3s ease;
  }

  .s.is-paid {
    background: #d6d6d6;
  }
  .s.is-open {
    background: var(--accent);
  }
  .s.is-overdue {
    background: var(--ink);
  }

  .rows li:hover .s {
    filter: brightness(1.1);
  }

  /* ---------- Daftar overdue ---------- */
  .late {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .late li {
    border-top: 1px solid var(--line);
    animation: row-in 0.6s var(--ease) both;
    animation-delay: calc(var(--i, 0) * 60ms + 240ms);
  }

  .late li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .late a {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    padding: 14px 0;
    color: inherit;
    text-decoration: none;
  }

  .late a:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 2px;
  }

  .mod {
    padding: 2px 0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-align: center;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
  }

  .who {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cust {
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.25s ease;
  }

  .late a:hover .cust {
    color: var(--accent);
  }

  .meta {
    margin-top: 2px;
    font-size: 12px;
    color: var(--muted);
  }

  .amt {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .more {
    margin: 16px 0 0;
    font-size: 13px;
  }

  .more a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }

  .more a:hover {
    text-decoration-color: var(--ink);
  }

  .quiet {
    margin: 0;
    padding: 20px 0;
    font-size: 13px;
    color: var(--muted);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes grow-y {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes grow-x {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1040px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .panel.span-2 {
      grid-column: auto;
    }
    .kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .kpi:nth-child(3) {
      border-left: none;
    }
    .kpi:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 640px) {
    .kpis {
      grid-template-columns: 1fr;
    }
    .kpi + .kpi {
      border-left: none;
      border-top: 1px solid var(--line);
    }
    .kpi:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kpis,
    .panel,
    .bar,
    .s,
    .late li,
    .seg,
    .tip {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
