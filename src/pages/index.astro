---
import AppLayout from "../layouts/AppLayout.astro";
import { apInvoices, arInvoices, type Invoice } from "../lib/data/dummy";
import {
  money,
  todayISO,
  todayLong,
  hourBangkok,
  monthLabel,
  lastDayOfMonth,
  daysBetween,
  shortDate,
} from "../lib/format";

const profile = Astro.locals.profile;
const name = profile?.username ?? "there";
const hour = hourBangkok();
const greeting =
  hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
const today = todayISO();

const sum = (list: Invoice[]) => list.reduce((acc, i) => acc + i.amount, 0);

const apOpen = apInvoices.filter((i) => i.status !== "Paid");
const arOpen = arInvoices.filter((i) => i.status !== "Paid");
const apTotal = sum(apOpen);
const arTotal = sum(arOpen);
const net = arTotal - apTotal;

const tagged = [
  ...apInvoices.map((i) => ({ ...i, module: "AP" as const })),
  ...arInvoices.map((i) => ({ ...i, module: "AR" as const })),
];
const overdue = tagged.filter((i) => i.status === "Overdue");
const overdueTotal = sum(overdue);
const attention = [...overdue].sort((a, b) => b.amount - a.amount).slice(0, 5);

const months = [
  ...new Set([...apInvoices, ...arInvoices].map((i) => i.date.slice(0, 7))),
].sort();
const series = months.map((m) => ({
  key: m,
  label: monthLabel(m),
  end: lastDayOfMonth(m),
  ap: sum(apInvoices.filter((i) => i.date.startsWith(m))),
  ar: sum(arInvoices.filter((i) => i.date.startsWith(m))),
}));

const peak = Math.max(1, ...series.flatMap((s) => [s.ap, s.ar]));
const BAR_MAX = 170;
const px = (v: number) => Math.max(2, Math.round((v / peak) * BAR_MAX));

const daysLate = (due: string) => daysBetween(due, today);

const summary = overdue.length
  ? `${overdue.length} invoices are overdue and need follow-up, totalling ${money(overdueTotal)}.`
  : "Every invoice is on schedule.";
const heading = `${greeting}, ${name}`;
---

<AppLayout
  title={heading}
  section="Dashboard"
  meta={todayLong()}
  description={summary}
>
  <dl class="metrics">
    <div class="metric">
      <dt>Payables outstanding</dt>
      <dd class="value">{money(apTotal)}</dd>
      <dd class="hint">{apOpen.length} open invoices</dd>
    </div>
    <div class="metric">
      <dt>Receivables outstanding</dt>
      <dd class="value">{money(arTotal)}</dd>
      <dd class="hint">{arOpen.length} open invoices</dd>
    </div>
    <div class="metric">
      <dt>Net position</dt>
      <dd class="value">
        {net > 0 ? "+" : ""}
        {money(net)}
      </dd>
      <dd class="hint">Receivables minus payables</dd>
    </div>
    <div class="metric">
      <dt>Overdue</dt>
      <dd class="value">{overdue.length}</dd>
      <dd class="hint">{money(overdueTotal)} across both modules</dd>
    </div>
  </dl>

  <div class="grid">
    <section class="panel" aria-labelledby="chart-title">
      <header class="panel-head">
        <div>
          <h2 id="chart-title">Monthly activity</h2>
          <p>Invoices issued per month. Select a bar to open that month.</p>
        </div>
        <ul class="legend" aria-hidden="true">
          <li>
            <span class="swatch ap"></span>Payables
          </li>
          <li>
            <span class="swatch ar"></span>Receivables
          </li>
        </ul>
      </header>

      <div class="chart">
        {series.map((s) => (
          <div class="month">
            <div class="bars">
              <a
                class="bar ap"
                href={`/ap?start=${s.key}-01&end=${s.end}`}
                style={`--h: ${px(s.ap)}px`}
                data-tip={`Payables · ${money(s.ap)}`}
                aria-label={`Payables, ${s.label}: ${money(s.ap)}`}
              ></a>
              <a
                class="bar ar"
                href={`/ar?start=${s.key}-01&end=${s.end}`}
                style={`--h: ${px(s.ar)}px`}
                data-tip={`Receivables · ${money(s.ar)}`}
                aria-label={`Receivables, ${s.label}: ${money(s.ar)}`}
              ></a>
            </div>
            <span class="month-label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="panel" aria-labelledby="attn-title">
      <header class="panel-head">
        <div>
          <h2 id="attn-title">Needs attention</h2>
          <p>Overdue invoices across both modules, largest first.</p>
        </div>
        <span class="count">{overdue.length}</span>
      </header>

      {attention.length === 0 ? (
        <p class="quiet">Nothing is overdue right now.</p>
      ) : (
        <ul class="attn">
          {attention.map((a) => (
            <li>
              <a href={`/${a.module.toLowerCase()}?status=Overdue`}>
                <span class="mod">{a.module}</span>
                <span class="body">
                  <strong>{a.customer}</strong>
                  <span class="meta">
                    {a.id} · {daysLate(a.dueDate)} days late · due{" "}
                    {shortDate(a.dueDate)}
                  </span>
                </span>
                <span class="amt">{money(a.amount)}</span>
                <svg
                  class="go"
                  width="14"
                  height="14"
                  viewBox="0 0 14 14"
                  aria-hidden="true"
                >
                  <path
                    d="M2 7h10M8 3l4 4-4 4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                  />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</AppLayout>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0 0 48px;
    border-top: 1px solid var(--ink);
  }

  .metric {
    position: relative;
    padding: 22px 24px 24px 0;
  }

  .metric + .metric {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  /* Garis hitam tebal yang tumbuh saat hover */
  .metric::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--ink);
    transition: width 0.6s var(--ease);
  }

  .metric + .metric::before {
    left: 24px;
  }

  .metric:hover::before {
    width: calc(100% - 24px);
  }
  .metric:first-child:hover::before {
    width: 100%;
  }

  .metric dt {
    margin: 0 0 12px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .value {
    margin: 0;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.015em;
    font-variant-numeric: tabular-nums;
  }

  .hint {
    margin: 8px 0 0;
    font-size: 12px;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  .panel {
    padding: 28px;
    background: var(--paper);
    border: 1px solid var(--line);
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 28px;
  }

  .panel h2 {
    margin: 0 0 4px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .panel-head p {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }

  .legend {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .swatch {
    width: 8px;
    height: 8px;
  }

  .swatch.ap {
    background: var(--ink);
  }
  .swatch.ar {
    background: #bdbdbd;
  }

  /* ---------- Chart ---------- */
  .chart {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 12px;
    padding: 0 4px;
    border-bottom: 1px solid var(--ink);
  }

  .month {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .bars {
    height: 180px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 6px;
  }

  .bar {
    position: relative;
    width: 18px;
    height: var(--h);
    background: var(--ink);
    transition:
      opacity 0.25s ease,
      transform 0.45s var(--ease);
    transform-origin: bottom;
  }

  .bar.ar {
    background: #bdbdbd;
  }

  .chart:hover .bar {
    opacity: 0.32;
  }
  .bar:hover,
  .bar:focus-visible {
    opacity: 1;
  }

  .bar:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 3px;
  }

  .bar::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    padding: 6px 9px;
    font-size: 12px;
    white-space: nowrap;
    color: var(--paper);
    background: var(--ink);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 4px);
    transition:
      opacity 0.2s ease,
      transform 0.3s var(--ease);
  }

  .bar:hover::after,
  .bar:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .month-label {
    margin-top: 10px;
    padding-bottom: 2px;
    font-size: 12px;
    color: var(--muted);
  }

  /* ---------- Attention list ---------- */
  .count {
    padding: 2px 8px;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    border: 1px solid var(--ink);
  }

  .quiet {
    margin: 0;
    padding: 24px 0;
    font-size: 13px;
    color: var(--muted);
  }

  .attn {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .attn li {
    border-top: 1px solid var(--line);
  }
  .attn li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .attn a {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto 14px;
    gap: 14px;
    align-items: center;
    padding: 14px 0;
    color: inherit;
    text-decoration: none;
    transition: padding 0.35s var(--ease);
  }

  .attn a:hover {
    padding-left: 6px;
  }

  .attn a:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 2px;
  }

  .mod {
    padding: 3px 0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-align: center;
    border: 1px solid var(--ink);
  }

  .body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .body strong {
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .body .meta {
    font-size: 12px;
    color: var(--muted);
  }

  .amt {
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .go {
    color: var(--muted);
    transition:
      transform 0.35s var(--ease),
      color 0.2s ease;
  }

  .attn a:hover .go {
    transform: translateX(3px);
    color: var(--ink);
  }

  @media (max-width: 1180px) {
    .metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .metric:nth-child(3) {
      padding-left: 0;
      border-left: none;
    }
    .metric:nth-child(3)::before {
      left: 0;
    }
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .metric,
    .metric + .metric {
      padding-left: 0;
      border-left: none;
    }
    .metric + .metric::before {
      left: 0;
    }
    .panel {
      padding: 20px;
    }
    .legend {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    .bar::after,
    .metric::before,
    .attn a,
    .go {
      transition: none !important;
    }
  }
</style>
