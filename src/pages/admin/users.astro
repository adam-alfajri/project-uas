---
import AppLayout from "../../layouts/AppLayout.astro";

const profile = Astro.locals.profile;
if (profile?.role !== "admin") {
  return Astro.redirect("/?error=forbidden");
}

const success = Astro.url.searchParams.has("success");
const error = Astro.url.searchParams.get("error");
---

<AppLayout
  title="Manage Users"
  section="Admin"
  meta="Administration"
  description="Create accounts for people who need access. New users sign in with the email and password you set here."
>
  <div class="wrap">
    {success && (
      <div class="notice is-ok" role="status">
        <span class="dot" aria-hidden="true"></span>
        User created. They can sign in now.
      </div>
    )}

    {error && (
      <div class="notice is-error" role="alert">
        <span class="dot" aria-hidden="true"></span>
        {error}
      </div>
    )}

    <form
      class="form"
      method="POST"
      action="/api/admin/users/create"
      novalidate
      data-form
    >
      <div class="intro">
        <h2>New account</h2>
        <p>
          Choose a role carefully. Administrators can manage users and see every
          module.
        </p>
      </div>

      <div class="fields">
        <div class="field">
          <label for="username">Username</label>
          <input
            id="username"
            class="control"
            name="username"
            type="text"
            placeholder="e.g. rina.sales"
            autocomplete="off"
            required
            autofocus
          />
          <span class="hint">Shown in the header after sign in.</span>
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input
            id="email"
            class="control"
            name="email"
            type="email"
            placeholder="name@company.com"
            autocomplete="off"
            required
          />
          <span class="hint">Used to sign in.</span>
        </div>

        <div class="field">
          <label for="password">Temporary password</label>
          <div class="password-wrap">
            <input
              id="password"
              class="control"
              name="password"
              type="password"
              placeholder="At least 8 characters"
              autocomplete="new-password"
              minlength="8"
              required
            />
            <button
              type="button"
              class="toggle"
              data-toggle-password
              aria-label="Show password"
            >
              Show
            </button>
          </div>
          <span class="hint" data-strength>
            Use at least 8 characters.
          </span>
        </div>

        <fieldset class="field role">
          <legend>Role</legend>
          <div class="options">
            <label class="option">
              <input type="radio" name="role" value="user" checked />
              <span class="option-body">
                <span class="option-title">Member</span>
                <span class="option-text">
                  Views and filters data in each module.
                </span>
              </span>
            </label>
            <label class="option">
              <input type="radio" name="role" value="admin" />
              <span class="option-body">
                <span class="option-title">Administrator</span>
                <span class="option-text">
                  Manages users and has full access.
                </span>
              </span>
            </label>
          </div>
        </fieldset>
      </div>

      <div class="actions">
        <p class="note">
          The account is created instantly, with email already confirmed.
        </p>
        <button class="submit" type="submit" data-submit>
          Create account
        </button>
      </div>
    </form>
  </div>
</AppLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-form]");
  const password = document.getElementById(
    "password",
  ) as HTMLInputElement | null;
  const toggleBtn = document.querySelector<HTMLButtonElement>(
    "[data-toggle-password]",
  );
  const strength = document.querySelector<HTMLElement>("[data-strength]");
  const submit = document.querySelector<HTMLButtonElement>("[data-submit]");

  toggleBtn?.addEventListener("click", () => {
    if (!password) return;
    const show = password.type === "password";
    password.type = show ? "text" : "password";
    toggleBtn.textContent = show ? "Hide" : "Show";
    toggleBtn.setAttribute(
      "aria-label",
      show ? "Hide password" : "Show password",
    );
  });

  password?.addEventListener("input", () => {
    if (!strength) return;
    const v = password.value;
    if (!v) {
      strength.textContent = "Use at least 8 characters.";
    } else if (v.length < 8) {
      strength.textContent = `${8 - v.length} more characters needed.`;
    } else if (v.length < 12) {
      strength.textContent = "Acceptable. A longer password is safer.";
    } else {
      strength.textContent = "Strong length.";
    }
  });

  form?.addEventListener("submit", () => {
    if (!submit) return;
    submit.disabled = true;
    submit.textContent = "Creating...";
  });

  window.addEventListener("pageshow", () => {
    if (!submit) return;
    submit.disabled = false;
    submit.textContent = "Create account";
  });
</script>

<style>
  .wrap {
    display: grid;
    gap: 24px;
    max-width: 880px;
  }

  .notice {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    font-size: 14px;
    border-radius: 10px;
    border: 1px solid #e8e8e6;
    background: #fafafa;
    animation: rise 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .notice .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }

  .notice.is-ok .dot {
    background: #3f5f8a;
  }
  .notice.is-error {
    border-color: #111;
  }
  .notice.is-error .dot {
    background: #111;
  }

  .form {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 48px;
    padding: 32px;
    background: #ffffff;
    border: 1px solid #ebebea;
    border-radius: 12px;
  }

  .intro h2 {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 600;
  }

  .intro p {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: #737373;
  }

  .fields {
    display: grid;
    gap: 24px;
  }

  .field {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: none;
  }

  .field > label,
  .field legend {
    margin: 0 0 8px;
    padding: 0;
    font-size: 12px;
    font-weight: 500;
    color: #3a3a3a;
  }

  .control {
    width: 100%;
    height: 40px;
    padding: 0 12px;
    font: inherit;
    font-size: 14px;
    color: #111;
    background: #fff;
    border: 1px solid #d4d4d4;
    border-radius: 8px;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .control::placeholder {
    color: #a3a3a3;
  }
  .control:hover {
    border-color: #b5b5b5;
  }

  .control:focus {
    outline: none;
    border-color: #3f5f8a;
    box-shadow: 0 0 0 3px rgba(63, 95, 138, 0.12);
  }

  .hint {
    margin-top: 6px;
    font-size: 12px;
    color: #8a8a8a;
  }

  .password-wrap {
    position: relative;
  }
  .password-wrap .control {
    padding-right: 64px;
  }

  .toggle {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    height: 28px;
    padding: 0 10px;
    font: inherit;
    font-size: 12px;
    color: #737373;
    background: none;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .toggle:hover {
    color: #111;
    background: #f6f6f5;
  }

  .options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .option {
    position: relative;
    display: flex;
    gap: 12px;
    padding: 16px;
    border: 1px solid #d4d4d4;
    border-radius: 10px;
    cursor: pointer;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease;
  }

  .option:hover {
    border-color: #111;
  }

  .option input {
    margin: 2px 0 0;
    accent-color: #111;
  }

  .option:has(input:checked) {
    border-color: #111;
    background: #fafafa;
  }

  .option:has(input:focus-visible) {
    outline: 1px solid #3f5f8a;
    outline-offset: 2px;
  }

  .option-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .option-title {
    font-size: 14px;
    font-weight: 500;
  }

  .option-text {
    font-size: 12px;
    line-height: 1.5;
    color: #737373;
  }

  .actions {
    grid-column: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid #ebebea;
  }

  .note {
    margin: 0;
    font-size: 12px;
    color: #8a8a8a;
  }

  .submit {
    height: 42px;
    padding: 0 22px;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    background: #111;
    border: 1px solid #111;
    border-radius: 8px;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      transform 0.15s ease;
  }

  .submit:hover:not(:disabled) {
    background: #2a2a2a;
  }
  .submit:active:not(:disabled) {
    transform: scale(0.98);
  }
  .submit:disabled {
    opacity: 0.55;
    cursor: wait;
  }

  .submit:focus-visible,
  .toggle:focus-visible {
    outline: 1px solid #3f5f8a;
    outline-offset: 2px;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .form {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 24px;
    }

    .actions {
      grid-column: 1;
      flex-direction: column-reverse;
      align-items: stretch;
    }
    .submit {
      width: 100%;
    }
    .options {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notice {
      animation: none;
    }
  }
</style>
