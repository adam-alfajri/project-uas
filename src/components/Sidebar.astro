---
import { apInvoices, arInvoices } from "../lib/data/dummy";

const ICONS = {
  overview: "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z",
  payable: "M17 7L7 17M7 17h9M7 17V8",
  receivable: "M7 17L17 7M17 7H8M17 7v9",
  reports: "M4 20V12M10 20V6M16 20v-8M2 20h20",
  users: "M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM2 20a7 7 0 0 1 14 0",
} as const;

type Icon = keyof typeof ICONS;
type Child = { label: string; href: string };
type Entry = {
  label: string;
  href: string;
  icon: Icon;
  badge?: number;
  children?: Child[];
};
type Group = { title: string; entries: Entry[] };

const path = Astro.url.pathname;
const profile = Astro.locals.profile;

const openAP = apInvoices.filter((i) => i.status !== "Paid").length;
const openAR = arInvoices.filter((i) => i.status !== "Paid").length;

const groups: Group[] = [
  {
    title: "Overview",
    entries: [{ label: "Dashboard", href: "/", icon: "overview" }],
  },
  {
    title: "Transactions",
    entries: [
      { label: "Account Payable", href: "/ap", icon: "payable", badge: openAP },
      {
        label: "Account Receivable",
        href: "/ar",
        icon: "receivable",
        badge: openAR,
      },
    ],
  },
  {
    title: "Reports",
    entries: [
      {
        label: "Financial Report",
        href: "/reports",
        icon: "reports",
        children: [
          { label: "Forecasting", href: "/reports/forecast" },
          { label: "Laba Rugi", href: "/reports/laba-rugi" },
          { label: "Arus Kas", href: "/reports/arus-kas" },
        ],
      },
    ],
  },
];

if (profile?.role === "admin") {
  groups.push({
    title: "Admin",
    entries: [{ label: "Manage Users", href: "/admin/users", icon: "users" }],
  });
}

const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<aside class="sidebar" id="sidebar" aria-label="Primary">
  <div class="inner">
    <a class="brand" href="/">
      <span class="mark" aria-hidden="true"></span>
      <span>Fajri Finance</span>
    </a>

    <nav class="nav" aria-label="Modules">
      {groups.map((g) => (
        <section class="group">
          <p class="group-title">{g.title}</p>
          <ul class="list">
            {g.entries.map((e) => {
              const active = isActive(e.href);
              return (
                <li>
                  <a
                    class={active ? "entry is-active" : "entry"}
                    href={e.href}
                    aria-current={active ? "page" : undefined}
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={ICONS[e.icon]} />
                    </svg>
                    <span class="text">{e.label}</span>
                    {e.badge !== undefined && (
                      <span class="badge">{e.badge}</span>
                    )}
                  </a>

                  {e.children && (
                    <ul class="children">
                      {e.children.map((c) => {
                        const current = path === c.href;
                        return (
                          <li>
                            <a
                              class={current ? "child is-current" : "child"}
                              href={c.href}
                              aria-current={current ? "page" : undefined}
                            >
                              {c.label}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </nav>

    <footer class="foot">
      <span>Fajri Finance</span>
      <span>v1.0</span>
    </footer>
  </div>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: #0f0f0f;
    color: #f2f2f2;
  }

  /* Lebar konten dipertahankan saat dilipat, supaya tidak ada teks yang terpotong saat transisi */
  .inner {
    width: 248px;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 24px 16px 20px;
    overflow-y: auto;
    transition: opacity 0.4s ease;
  }

  .app.sidebar-collapsed .inner {
    opacity: 0;
    pointer-events: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 4px 12px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: inherit;
    text-decoration: none;
  }

  .mark {
    width: 14px;
    height: 14px;
    background: #fff;
  }

  .group {
    margin-top: 32px;
  }

  .group-title {
    margin: 0 0 8px;
    padding: 0 12px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5a5a5a;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 36px;
    padding: 0 12px;
    border-radius: 6px;
    font-size: 14px;
    color: #9a9a9a;
    text-decoration: none;
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .entry svg {
    width: 16px;
    height: 16px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .entry:hover {
    color: #e6e6e6;
    background: rgba(255, 255, 255, 0.04);
  }

  .entry.is-active {
    color: #fff;
    background: rgba(255, 255, 255, 0.07);
  }

  .entry.is-active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    bottom: 9px;
    width: 2px;
    border-radius: 2px;
    background: #7d9bc4;
  }

  .text {
    flex: 1;
    min-width: 0;
  }

  .badge {
    min-width: 24px;
    padding: 0 7px;
    line-height: 18px;
    font-size: 11px;
    text-align: center;
    font-variant-numeric: tabular-nums;
    color: #8a8a8a;
    border: 1px solid #2e2e2e;
    border-radius: 999px;
  }

  .entry.is-active .badge {
    color: #fff;
    border-color: #4a4a4a;
  }

  .children {
    list-style: none;
    margin: 2px 0 6px 26px;
    padding: 0 0 0 12px;
    border-left: 1px solid #262626;
  }

  .child {
    display: block;
    padding: 6px 0;
    font-size: 13px;
    color: #737373;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .child:hover {
    color: #e6e6e6;
  }
  .child.is-current {
    color: #7d9bc4;
  }

  .entry:focus-visible,
  .child:focus-visible,
  .brand:focus-visible {
    outline: 1px solid #7d9bc4;
    outline-offset: 2px;
  }

  .foot {
    margin-top: auto;
    padding: 24px 12px 0;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #4d4d4d;
  }

  @media (max-width: 960px) {
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 280px;
      height: 100dvh;
      transform: translateX(-100%);
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .inner {
      width: 280px;
    }

    .app.sidebar-collapsed .inner {
      opacity: 1;
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<style is:global>
  @media (max-width: 960px) {
    .app.nav-open > .sidebar {
      transform: none;
      box-shadow: 24px 0 48px -24px rgba(0, 0, 0, 0.4);
    }
  }
</style>
