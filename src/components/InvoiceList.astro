---
import type { Invoice, InvoiceStatus } from "../lib/data/dummy";
import { money, shortDate, todayISO, daysBetween } from "../lib/format";

interface Props {
  invoices: Invoice[];
  basePath: string;
}

const { invoices, basePath } = Astro.props;
const params = Astro.url.searchParams;

type SortKey = "date" | "due" | "amount";
const SORTS: SortKey[] = ["date", "due", "amount"];
const STATUSES: InvoiceStatus[] = ["Open", "Overdue", "Paid"];
const PER_PAGE = 10;

const sortParam = params.get("sort") ?? "";
const sortKey: SortKey = (SORTS as string[]).includes(sortParam)
  ? (sortParam as SortKey)
  : "date";
const dir: "asc" | "desc" = params.get("dir") === "asc" ? "asc" : "desc";

const f = {
  start: params.get("start") ?? "",
  end: params.get("end") ?? "",
  customer: params.get("customer") ?? "",
  sales: params.get("sales") ?? "",
  q: (params.get("q") ?? "").trim(),
  status: (params.get("status") ?? "") as InvoiceStatus | "",
};
const filtered = Boolean(
  f.start || f.end || f.customer || f.sales || f.q || f.status,
);

const sum = (list: Invoice[]) => list.reduce((acc, i) => acc + i.amount, 0);

const inScope = (inv: Invoice) => {
  if (f.start && inv.date < f.start) return false;
  if (f.end && inv.date > f.end) return false;
  if (f.customer && inv.customer !== f.customer) return false;
  if (f.sales && inv.sales !== f.sales) return false;
  if (f.q) {
    const q = f.q.toLowerCase();
    if (
      !inv.id.toLowerCase().includes(q) &&
      !inv.customer.toLowerCase().includes(q)
    )
      return false;
  }
  return true;
};

const scope = invoices.filter(inScope);
const rows = scope.filter((inv) => !f.status || inv.status === f.status);

const field = sortKey === "due" ? "dueDate" : "date";
const sorted = [...rows].sort((a, b) => {
  const cmp =
    sortKey === "amount"
      ? a.amount - b.amount
      : a[field].localeCompare(b[field]);
  return dir === "asc" ? cmp : -cmp;
});

const pageCount = Math.max(1, Math.ceil(sorted.length / PER_PAGE));
const requested = Number.parseInt(params.get("page") ?? "1", 10);
const page = Number.isNaN(requested)
  ? 1
  : Math.min(Math.max(requested, 1), pageCount);
const pageRows = sorted.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const from = sorted.length ? (page - 1) * PER_PAGE + 1 : 0;
const to = Math.min(page * PER_PAGE, sorted.length);

const countOf = (s: InvoiceStatus) =>
  scope.filter((i) => i.status === s).length;
const customers = [...new Set(invoices.map((i) => i.customer))].sort();
const salesList = [...new Set(invoices.map((i) => i.sales))].sort();

const today = todayISO();
const dueNote = (inv: Invoice) => {
  if (inv.status === "Paid") return null;
  const d = daysBetween(today, inv.dueDate);
  if (d < 0) return { text: `${-d} days late`, late: true };
  if (d === 0) return { text: "Due today", late: false };
  return { text: `${d} days left`, late: false };
};

const selectedId = params.get("id") ?? "";
const selected = invoices.find((i) => i.id === selectedId) ?? null;
const selectedNote = selected ? dueNote(selected) : null;
const viewTotal = sum(scope);
const selectedShare =
  selected && viewTotal ? (selected.amount / viewTotal) * 100 : 0;

const link = (over: Record<string, string>) => {
  const p = new URLSearchParams(params);
  if (!("page" in over)) p.delete("page");
  for (const [k, v] of Object.entries(over)) {
    if (v) p.set(k, v);
    else p.delete(k);
  }
  const qs = p.toString();
  return qs ? `${basePath}?${qs}` : basePath;
};

const sortLink = (k: SortKey) =>
  link({
    sort: k,
    dir: sortKey === k && dir === "desc" ? "asc" : "desc",
    page: "",
  });

const ariaSort = (k: SortKey) =>
  sortKey !== k ? "none" : dir === "asc" ? "ascending" : "descending";

const arrow = (k: SortKey) =>
  sortKey === k ? (dir === "asc" ? "↑" : "↓") : "";
---

<section class="ledger">
  <div class="toolbar-top">
    <p class="count">
      <strong>{sorted.length}</strong> invoices · {money(sum(sorted))}
    </p>
    <p class="overdue-sum">
      Overdue{" "}
      <strong>
        {money(sum(sorted.filter((r) => r.status === "Overdue")))}
      </strong>
    </p>
  </div>

  <form class="filters" method="GET" action={basePath} data-toolbar>
    <input type="hidden" name="status" value={f.status} />
    <input type="hidden" name="sort" value={sortKey} />
    <input type="hidden" name="dir" value={dir} />
    <input type="hidden" name="id" value={selectedId} />

    <label class="field">
      <span class="name">From</span>
      <input class="control" type="date" name="start" value={f.start} />
    </label>

    <label class="field">
      <span class="name">To</span>
      <input class="control" type="date" name="end" value={f.end} />
    </label>

    <label class="field">
      <span class="name">Customer</span>
      <span class="select">
        <select class="control" name="customer">
          <option value="">All</option>
          {customers.map((c) => (
            <option value={c} selected={c === f.customer}>
              {c}
            </option>
          ))}
        </select>
      </span>
    </label>

    <label class="field">
      <span class="name">Sales</span>
      <span class="select">
        <select class="control" name="sales">
          <option value="">All</option>
          {salesList.map((s) => (
            <option value={s} selected={s === f.sales}>
              {s}
            </option>
          ))}
        </select>
      </span>
    </label>

    <label class="field">
      <span class="name">Search</span>
      <input
        class="control"
        type="search"
        name="q"
        value={f.q}
        placeholder="Invoice or customer"
        autocomplete="off"
        data-search
      />
    </label>
  </form>

  <nav class="tabs" aria-label="Status">
    <a
      class={!f.status ? "tab is-on" : "tab"}
      href={link({ status: "", page: "" })}
      aria-current={!f.status ? "true" : undefined}
    >
      All <span>{scope.length}</span>
    </a>
    {STATUSES.map((s) => (
      <a
        class={f.status === s ? "tab is-on" : "tab"}
        href={link({ status: s, page: "" })}
        aria-current={f.status === s ? "true" : undefined}
      >
        {s} <span>{countOf(s)}</span>
      </a>
    ))}
  </nav>

  <div class={selected ? "workspace has-detail" : "workspace"}>
    <div class="table-col">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Invoice</th>
              <th scope="col">Customer</th>
              <th scope="col">Sales</th>
              <th scope="col" aria-sort={ariaSort("date")}>
                <a class="sort" href={sortLink("date")}>
                  Issued<i aria-hidden="true">{arrow("date")}</i>
                </a>
              </th>
              <th scope="col" aria-sort={ariaSort("due")}>
                <a class="sort" href={sortLink("due")}>
                  Due<i aria-hidden="true">{arrow("due")}</i>
                </a>
              </th>
              <th scope="col">Status</th>
              <th scope="col" class="num" aria-sort={ariaSort("amount")}>
                <a class="sort sort-end" href={sortLink("amount")}>
                  Amount<i aria-hidden="true">{arrow("amount")}</i>
                </a>
              </th>
            </tr>
          </thead>

          <tbody>
            {pageRows.length === 0 ? (
              <tr class="empty">
                <td colspan="7">
                  <p class="empty-title">Nothing matches these filters.</p>
                  <a class="text-link" href={basePath}>
                    Clear all filters
                  </a>
                </td>
              </tr>
            ) : (
              pageRows.map((r, i) => {
                const note = dueNote(r);
                const isSel = selected?.id === r.id;
                const cls = [
                  isSel ? "is-selected" : "",
                  r.status === "Overdue" ? "is-overdue" : "",
                ]
                  .filter(Boolean)
                  .join(" ");
                return (
                  <tr class={cls || undefined} style={`--i: ${i}`}>
                    <td>
                      <a
                        class="id"
                        href={link({ id: r.id })}
                        aria-current={isSel ? "true" : undefined}
                      >
                        {r.id}
                      </a>
                    </td>
                    <td class="customer">{r.customer}</td>
                    <td>{r.sales}</td>
                    <td class="muted">{shortDate(r.date)}</td>
                    <td>
                      <span class="due">{shortDate(r.dueDate)}</span>
                      {note && (
                        <span class={note.late ? "note is-late" : "note"}>
                          {note.text}
                        </span>
                      )}
                    </td>
                    <td>
                      <span class={`status is-${r.status.toLowerCase()}`}>
                        {r.status}
                      </span>
                    </td>
                    <td class="num">{money(r.amount)}</td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>

      <nav class="pager" aria-label="Pagination">
        <p class="range">
          {from}–{to} of {sorted.length}
        </p>
        <div class="pager-ctrl">
          {page > 1 ? (
            <a
              class="text-link"
              href={link({ page: String(page - 1) })}
              rel="prev"
            >
              Previous
            </a>
          ) : (
            <span class="off">Previous</span>
          )}
          <span class="page">
            Page {page} of {pageCount}
          </span>
          {page < pageCount ? (
            <a
              class="text-link"
              href={link({ page: String(page + 1) })}
              rel="next"
            >
              Next
            </a>
          ) : (
            <span class="off">Next</span>
          )}
        </div>
        {filtered && (
          <a class="text-link" href={basePath}>
            Clear filters
          </a>
        )}
      </nav>
    </div>

    {selected && (
      <aside class="detail" aria-labelledby="detail-title">
        <div class="detail-head">
          <p class="eyebrow">Invoice</p>
          <a class="close" href={link({ id: "" })} data-close-detail>
            Close
          </a>
        </div>

        <h2 id="detail-title" class="detail-id">
          {selected.id}
        </h2>
        <p class="detail-amount">{money(selected.amount)}</p>
        <p class="detail-share">
          {selectedShare.toFixed(1)}% of the current view
        </p>

        <dl class="facts">
          <div>
            <dt>Customer</dt>
            <dd>{selected.customer}</dd>
          </div>
          <div>
            <dt>Sales</dt>
            <dd>{selected.sales}</dd>
          </div>
          <div>
            <dt>Issued</dt>
            <dd>{shortDate(selected.date)}</dd>
          </div>
          <div>
            <dt>Due</dt>
            <dd>{shortDate(selected.dueDate)}</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>
              <span class={`status is-${selected.status.toLowerCase()}`}>
                {selected.status}
              </span>
            </dd>
          </div>
          <div>
            <dt>Timing</dt>
            <dd>{selectedNote ? selectedNote.text : "Settled"}</dd>
          </div>
        </dl>
      </aside>
    )}
  </div>
</section>

<script>
  const toolbar = document.querySelector<HTMLFormElement>("[data-toolbar]");

  if (toolbar) {
    toolbar
      .querySelectorAll<HTMLInputElement | HTMLSelectElement>(
        'select, input[type="date"], input[type="search"]',
      )
      .forEach((el) =>
        el.addEventListener("change", () => toolbar.requestSubmit()),
      );
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      document.querySelector<HTMLAnchorElement>("[data-close-detail]")?.click();
    }
  });
</script>

<style>
  .ledger {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .toolbar-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .toolbar-top strong {
    font-weight: 600;
    color: var(--ink);
  }

  .count,
  .overdue-sum {
    margin: 0;
  }

  .filters {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(0, 1.3fr);
    gap: 24px;
    align-items: end;
    padding: 20px;
    background: var(--wash);
    border-radius: 10px;
  }

  .field {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .field .name {
    margin-bottom: 6px;
    font-size: 12px;
    color: var(--muted);
  }

  .control {
    width: 100%;
    height: 36px;
    padding: 0 10px;
    font: inherit;
    font-size: 14px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .control:hover {
    border-color: #b5b5b5;
  }

  .control:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(63, 95, 138, 0.12);
  }

  .control[type="date"] {
    font-variant-numeric: tabular-nums;
  }

  .select {
    position: relative;
    display: block;
  }

  .select .control {
    padding-right: 28px;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }

  .select::after {
    content: "";
    position: absolute;
    right: 12px;
    top: 13px;
    width: 6px;
    height: 6px;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    transform: rotate(45deg);
    pointer-events: none;
  }

  .tabs {
    display: flex;
    gap: 4px;
    padding: 4px;
    width: fit-content;
    background: var(--wash);
    border-radius: 10px;
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 14px;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    border-radius: 7px;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s ease;
  }

  .tab span {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }

  .tab:hover {
    color: var(--ink);
  }

  .tab.is-on {
    color: var(--ink);
    background: var(--paper);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
  }

  .workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }

  .workspace.has-detail {
    grid-template-columns: minmax(0, 1fr) 300px;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  th {
    padding: 12px 16px;
    font-size: 12px;
    font-weight: 500;
    text-align: left;
    white-space: nowrap;
    color: var(--muted);
    background: var(--wash);
    border-bottom: 1px solid var(--line);
  }

  td {
    padding: 14px 16px;
    white-space: nowrap;
    vertical-align: middle;
    border-bottom: 1px solid var(--line);
    position: relative;
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  tbody tr {
    animation: row-in 0.6s var(--ease) both;
    animation-delay: calc(var(--i, 0) * 40ms);
  }

  tbody tr:hover td {
    background: #fbfbfa;
  }

  /* Baris terpilih ditandai garis biru di tepi kiri */
  tbody tr.is-selected td {
    background: #f3f6fa;
  }

  tbody tr.is-selected td:first-child::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
  }

  .num,
  th.num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .id {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .id:hover {
    border-bottom-color: var(--ink);
  }

  .id[aria-current="true"] {
    color: var(--accent);
  }

  .id:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .customer {
    font-weight: 500;
  }
  .muted {
    color: var(--muted);
  }

  .due {
    display: block;
  }

  .note {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    color: var(--muted);
  }

  .note.is-late {
    color: var(--ink);
    font-weight: 500;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--ink-2);
  }

  .status::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid var(--ink);
  }

  .status.is-open::before {
    background: transparent;
  }
  .status.is-paid {
    color: var(--muted);
  }
  .status.is-paid::before {
    background: var(--faint);
    border-color: var(--faint);
  }

  .status.is-overdue {
    font-weight: 600;
    color: var(--ink);
  }

  .status.is-overdue::before {
    background: var(--ink);
  }

  .sort {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .sort:hover {
    color: var(--ink);
  }

  .sort i {
    display: inline-block;
    width: 8px;
    font-style: normal;
    color: var(--ink);
  }

  .sort-end {
    justify-content: flex-end;
    width: 100%;
  }

  .empty td {
    padding: 64px 16px;
    text-align: center;
    white-space: normal;
  }

  .empty-title {
    margin: 0 0 10px;
    font-size: 15px;
    font-weight: 500;
  }

  .text-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.25s ease;
  }

  .text-link:hover {
    text-decoration-color: var(--ink);
  }

  .text-link:focus-visible,
  .sort:focus-visible,
  .close:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }

  .pager {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 16px;
    font-size: 13px;
    color: var(--muted);
  }

  .pager .range {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .pager-ctrl {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-left: auto;
  }

  .pager .page {
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }

  .off {
    color: var(--line-strong);
  }

  .detail {
    position: sticky;
    top: 88px;
    padding: 24px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    animation: rise 0.5s var(--ease) both;
  }

  .detail-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .eyebrow {
    margin: 0;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .close {
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .close:hover {
    color: var(--ink);
  }

  .detail-id {
    margin: 16px 0 0;
    font-size: 18px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .detail-amount {
    margin: 8px 0 0;
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .detail-share {
    margin: 4px 0 0;
    font-size: 12px;
    color: var(--muted);
  }

  .facts {
    margin: 24px 0 0;
    border-top: 1px solid var(--line);
  }

  .facts div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .facts dt {
    font-size: 12px;
    color: var(--muted);
  }

  .facts dd {
    margin: 0;
    font-size: 13px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1180px) {
    .filters {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .search-field {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 1040px) {
    .workspace.has-detail {
      grid-template-columns: 1fr;
    }
    .detail {
      position: static;
    }
  }

  @media (max-width: 720px) {
    .filters {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    tbody tr,
    .detail,
    .tab,
    .control,
    .sort,
    .id,
    .close {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
