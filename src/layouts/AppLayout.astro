---
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title: string;
  section?: string;
  meta?: string;
  description?: string;
}

const { title, section, meta, description } = Astro.props;
const profile = Astro.locals.profile;
const initials = (profile?.username ?? "??").slice(0, 2).toUpperCase();
const roleLabel = profile?.role === "admin" ? "Administrator" : "Member";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Fajri Finance</title>
    <style>
      :root {
        --black: #0f0f0f;
        --ink: #111111;
        --ink-2: #3b3b3b;
        --muted: #6b6b6b;
        --faint: #a6a6a6;
        --line: #e6e6e6;
        --line-strong: #cfcfcf;
        --canvas: #fafaf9;
        --paper: #ffffff;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        font-family:
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          sans-serif;
        font-size: 14px;
        line-height: 1.5;
        color: var(--ink);
        background: var(--canvas);
        -webkit-font-smoothing: antialiased;
      }

      button {
        font: inherit;
      }

      .app {
        min-height: 100vh;
        min-height: 100dvh;
        display: grid;
        grid-template-columns: 248px minmax(0, 1fr);
      }

      .scrim {
        display: none;
      }

      .main {
        min-width: 0;
        display: flex;
        flex-direction: column;
      }

      /* ---------- Utility bar ---------- */
      .utility {
        position: sticky;
        top: 0;
        z-index: 20;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 0 40px;
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }

      .utility-left {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
      }

      .crumbs {
        font-size: 13px;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .crumbs strong {
        font-weight: 500;
        color: var(--ink);
      }

      .menu-btn {
        display: none;
        align-items: center;
        gap: 10px;
        height: 32px;
        padding: 0 10px 0 0;
        background: none;
        border: none;
        font-size: 13px;
        font-weight: 500;
        color: var(--ink);
        cursor: pointer;
      }

      .burger {
        position: relative;
        width: 16px;
        height: 10px;
      }

      .burger::before,
      .burger::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        height: 1px;
        background: var(--ink);
        transition:
          transform 0.35s var(--ease),
          top 0.35s var(--ease);
      }

      .burger::before {
        top: 0;
      }
      .burger::after {
        top: 9px;
      }

      .app.nav-open .burger::before {
        top: 4px;
        transform: rotate(45deg);
      }
      .app.nav-open .burger::after {
        top: 4px;
        transform: rotate(-45deg);
      }

      .menu-btn:focus-visible {
        outline: 1px solid var(--ink);
        outline-offset: 4px;
      }

      .account {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .avatar {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        background: var(--black);
        color: var(--paper);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.04em;
      }

      .who {
        display: flex;
        flex-direction: column;
        line-height: 1.25;
      }

      .who .name {
        font-size: 13px;
        font-weight: 500;
      }

      .who .role {
        font-size: 11px;
        color: var(--muted);
      }

      .divider {
        width: 1px;
        height: 20px;
        background: var(--line);
      }

      .signout {
        position: relative;
        padding: 6px 0;
        background: none;
        border: none;
        font-size: 13px;
        color: var(--ink-2);
        cursor: pointer;
      }

      .signout::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 2px;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: right center;
        transition: transform 0.4s var(--ease);
      }

      .signout:hover {
        color: var(--ink);
      }
      .signout:hover::after {
        transform: scaleX(1);
        transform-origin: left center;
      }

      .signout:focus-visible {
        outline: 1px solid var(--ink);
        outline-offset: 4px;
      }

      /* ---------- Konten ---------- */
      .content {
        width: 100%;
        max-width: 1280px;
        padding: 48px 48px 72px;
      }

      .page-head {
        margin-bottom: 40px;
      }

      .meta {
        margin: 0 0 10px;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }

      h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 500;
        line-height: 1.2;
        letter-spacing: -0.02em;
      }

      .desc {
        margin: 8px 0 0;
        max-width: 62ch;
        color: var(--ink-2);
      }

      .content > * {
        animation: rise 0.6s var(--ease) both;
      }

      .content > .page-head {
        animation-delay: 0s;
      }
      .content > :not(.page-head) {
        animation-delay: 0.08s;
      }

      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      /* ---------- Responsif ---------- */
      @media (max-width: 1100px) {
        .content {
          padding: 40px 32px 64px;
        }
      }

      @media (max-width: 900px) {
        .app {
          grid-template-columns: 1fr;
        }

        .menu-btn {
          display: inline-flex;
        }

        .utility {
          padding: 0 20px;
        }

        .content {
          padding: 32px 20px 56px;
        }

        .who,
        .divider {
          display: none;
        }

        .scrim {
          display: block;
          position: fixed;
          inset: 0;
          z-index: 40;
          background: rgba(15, 15, 15, 0.35);
          opacity: 0;
          pointer-events: none;
          transition: opacity 0.35s var(--ease);
        }

        .app.nav-open .scrim {
          opacity: 1;
          pointer-events: auto;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="app" id="app">
      <Sidebar />

      <button
        class="scrim"
        type="button"
        aria-label="Close menu"
        data-nav-close
      ></button>

      <div class="main">
        <header class="utility">
          <div class="utility-left">
            <button
              class="menu-btn"
              type="button"
              aria-controls="sidebar"
              aria-expanded="false"
              data-nav-toggle
            >
              <span class="burger" aria-hidden="true"></span>
              Menu
            </button>

            <nav class="crumbs" aria-label="Breadcrumb">
              <span>Fajri Finance</span>
              <span aria-hidden="true"> / </span>
              <strong>{section ?? title}</strong>
            </nav>
          </div>

          <div class="account">
            <span class="avatar" aria-hidden="true">
              {initials}
            </span>
            <div class="who">
              <span class="name">{profile?.username ?? "Guest"}</span>
              <span class="role">{roleLabel}</span>
            </div>
            <span class="divider" aria-hidden="true"></span>
            <form method="POST" action="/api/auth/logout">
              <button class="signout" type="submit">
                Sign out
              </button>
            </form>
          </div>
        </header>

        <div class="content">
          <div class="page-head">
            {meta && <p class="meta">{meta}</p>}
            <h1>{title}</h1>
            {description && <p class="desc">{description}</p>}
          </div>

          <slot />
        </div>
      </div>
    </div>

    <script>
      const app = document.getElementById("app") as HTMLElement;
      const toggle =
        document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
      const closers =
        document.querySelectorAll<HTMLElement>("[data-nav-close]");

      const setOpen = (open: boolean) => {
        app.classList.toggle("nav-open", open);
        toggle?.setAttribute("aria-expanded", String(open));
      };

      toggle?.addEventListener("click", () => {
        setOpen(!app.classList.contains("nav-open"));
      });

      closers.forEach((el) =>
        el.addEventListener("click", () => setOpen(false)),
      );

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
      });
    </script>
  </body>
</html>
