---
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title: string;
  section?: string;
  meta?: string;
  description?: string;
}

const { title, meta, description } = Astro.props;
const profile = Astro.locals.profile;
const roleLabel = profile?.role === "admin" ? "Administrator" : "Member";
const initials = (profile?.username ?? "G").slice(0, 2).toUpperCase();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Fajri Finance</title>
    <style is:global>
      @view-transition {
        navigation: auto;
      }

      :root {
        --ink: #111111;
        --ink-2: #3a3a3a;
        --muted: #737373;
        --faint: #a3a3a3;
        --line: #ebebea;
        --line-strong: #d4d4d4;
        --paper: #ffffff;
        --wash: #f6f6f5;
        --accent: #3f5f8a;
        --accent-soft: #c9d4e3;
        --sidebar-w: 248px;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        font-family:
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          sans-serif;
        font-size: 14px;
        line-height: 1.5;
        color: var(--ink);
        background: var(--paper);
        -webkit-font-smoothing: antialiased;
      }

      ::selection {
        background: var(--ink);
        color: var(--paper);
      }
      button {
        font: inherit;
      }
      a {
        color: inherit;
      }

      .skip {
        position: absolute;
        left: 16px;
        top: -64px;
        z-index: 100;
        padding: 10px 14px;
        font-size: 13px;
        color: var(--paper);
        background: var(--ink);
        text-decoration: none;
        transition: top 0.3s var(--ease);
      }

      .skip:focus {
        top: 12px;
      }

      .app {
        position: relative;
        min-height: 100vh;
        min-height: 100dvh;
        display: grid;
        grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
        transition: grid-template-columns 0.6s var(--ease);
      }

      .app.sidebar-collapsed {
        grid-template-columns: 0 minmax(0, 1fr);
      }

      .main {
        min-width: 0;
        display: flex;
        flex-direction: column;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 30;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        height: 64px;
        padding: 0 40px;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }

      .left {
        display: flex;
        align-items: center;
        gap: 20px;
        flex: 1;
        min-width: 0;
      }

      .toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: none;
        width: 36px;
        height: 36px;
        padding: 0;
        background: none;
        border: 1px solid var(--line-strong);
        border-radius: 8px;
        cursor: pointer;
        color: var(--ink);
        transition:
          border-color 0.25s ease,
          background-color 0.25s ease;
      }

      .toggle:hover {
        border-color: var(--ink);
      }

      .toggle-bars {
        position: relative;
        width: 14px;
        height: 8px;
        border-top: 1px solid currentColor;
        border-bottom: 1px solid currentColor;
      }

      .toggle-bars::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 50%;
        height: 1px;
        background: currentColor;
        transform: translateY(-50%);
        transition: transform 0.5s var(--ease);
      }

      .app.sidebar-collapsed .toggle-bars::after,
      .app.nav-open .toggle-bars::after {
        transform: translateY(-50%) scaleX(0);
      }

      .search {
        position: relative;
        width: min(380px, 100%);
      }

      .search svg {
        position: absolute;
        left: 12px;
        top: 10px;
        width: 16px;
        height: 16px;
        fill: none;
        stroke: var(--muted);
        stroke-width: 1.5;
        stroke-linecap: round;
        pointer-events: none;
      }

      .search input {
        width: 100%;
        height: 36px;
        padding: 0 44px 0 36px;
        font: inherit;
        font-size: 14px;
        color: var(--ink);
        background: var(--wash);
        border: 1px solid transparent;
        border-radius: 8px;
        transition:
          background-color 0.3s ease,
          border-color 0.3s ease,
          box-shadow 0.3s ease;
      }

      .search input::placeholder {
        color: var(--faint);
      }

      .search input:focus {
        outline: none;
        background: var(--paper);
        border-color: var(--accent-soft);
        box-shadow: 0 0 0 3px rgba(63, 95, 138, 0.12);
      }

      .search kbd {
        position: absolute;
        right: 10px;
        top: 9px;
        padding: 0 6px;
        font-family: ui-monospace, Consolas, monospace;
        font-size: 11px;
        color: var(--faint);
        border: 1px solid var(--line-strong);
        border-radius: 4px;
        pointer-events: none;
      }

      .search:focus-within kbd {
        opacity: 0;
      }

      .account {
        display: flex;
        align-items: center;
        gap: 14px;
        flex: none;
      }

      .avatar {
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--paper);
        background: var(--ink);
        border-radius: 8px;
      }

      .who {
        display: flex;
        flex-direction: column;
        line-height: 1.25;
      }

      .who .name {
        font-size: 13px;
        font-weight: 500;
      }
      .who .role {
        font-size: 12px;
        color: var(--muted);
      }

      .signout {
        height: 32px;
        padding: 0 12px;
        font-size: 13px;
        color: var(--ink-2);
        background: none;
        border: 1px solid var(--line-strong);
        border-radius: 8px;
        cursor: pointer;
        transition:
          border-color 0.3s ease,
          color 0.3s ease;
      }

      .signout:hover {
        color: var(--ink);
        border-color: var(--ink);
      }

      .toggle:focus-visible,
      .search input:focus-visible,
      .signout:focus-visible,
      .skip:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 2px;
      }

      .content {
        width: 100%;
        max-width: none;
        padding: 48px clamp(32px, 4vw, 64px) 96px;
      }

      .page-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 24px;
        margin-bottom: 40px;
        animation: rise 0.8s var(--ease) both;
      }

      .meta {
        margin: 0 0 8px;
        font-size: 12px;
        color: var(--muted);
      }

      h1 {
        margin: 0;
        font-size: clamp(28px, 3vw, 36px);
        font-weight: 500;
        line-height: 1.1;
        letter-spacing: -0.03em;
      }

      .desc {
        margin: 10px 0 0;
        max-width: 64ch;
        font-size: 14px;
        color: var(--ink-2);
      }

      .head-actions {
        font-size: 13px;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
      }

      .rise {
        animation: rise 0.8s var(--ease) 0.08s both;
      }

      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      .scrim {
        display: none;
      }

      @media (max-width: 960px) {
        .app,
        .app.sidebar-collapsed {
          grid-template-columns: 1fr;
        }

        .topbar {
          padding: 0 20px;
        }
        .content {
          padding: 32px 20px 72px;
        }
        .who {
          display: none;
        }

        .scrim {
          display: block;
          position: fixed;
          inset: 0;
          z-index: 40;
          background: rgba(15, 15, 15, 0.4);
          opacity: 0;
          pointer-events: none;
          transition: opacity 0.5s var(--ease);
        }

        .app.nav-open .scrim {
          opacity: 1;
          pointer-events: auto;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#content">
      Skip to content
    </a>

    <div class="app" id="app">
      <Sidebar />

      <button
        class="scrim"
        type="button"
        aria-label="Close menu"
        data-close
      ></button>

      <div class="main">
        <header class="topbar">
          <div class="left">
            <button
              class="toggle"
              type="button"
              aria-controls="sidebar"
              aria-expanded="true"
              aria-label="Toggle sidebar"
              data-toggle
            >
              <span class="toggle-bars" aria-hidden="true"></span>
            </button>

            <form class="search" role="search" action="/ap" method="GET">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="M20 20l-4-4" />
              </svg>
              <input
                type="search"
                name="q"
                placeholder="Search invoices or customers"
                autocomplete="off"
                aria-label="Search invoices"
                data-global-search
              />
              <kbd aria-hidden="true">/</kbd>
            </form>
          </div>

          <div class="account">
            <span class="avatar" aria-hidden="true">
              {initials}
            </span>
            <div class="who">
              <span class="name">{profile?.username ?? "Guest"}</span>
              <span class="role">{roleLabel}</span>
            </div>
            <form method="POST" action="/api/auth/logout">
              <button class="signout" type="submit">
                Sign out
              </button>
            </form>
          </div>
        </header>

        <main class="content" id="content">
          <div class="page-head">
            <div>
              {meta && <p class="meta">{meta}</p>}
              <h1>{title}</h1>
              {description && <p class="desc">{description}</p>}
            </div>
            <div class="head-actions">
              <slot name="actions" />
            </div>
          </div>

          <div class="rise">
            <slot />
          </div>
        </main>
      </div>
    </div>

    <script>
      const app = document.getElementById("app") as HTMLElement;
      const toggle = document.querySelector<HTMLButtonElement>("[data-toggle]");
      const isMobile = () => window.matchMedia("(max-width: 960px)").matches;
      const STORAGE_KEY = "fajri.sidebar";

      // Desktop: sidebar bisa dilipat. Mobile: sidebar jadi drawer.
      const applyDesktop = (open: boolean) => {
        app.classList.toggle("sidebar-collapsed", !open);
        toggle?.setAttribute("aria-expanded", String(open));
      };

      const applyMobile = (open: boolean) => {
        app.classList.toggle("nav-open", open);
        toggle?.setAttribute("aria-expanded", String(open));
      };

      const restore = () => {
        if (isMobile()) {
          app.classList.remove("sidebar-collapsed");
          applyMobile(false);
        } else {
          app.classList.remove("nav-open");
          const saved = localStorage.getItem(STORAGE_KEY);
          applyDesktop(saved !== "closed");
        }
      };

      restore();
      window.addEventListener("resize", restore);

      toggle?.addEventListener("click", () => {
        if (isMobile()) {
          applyMobile(!app.classList.contains("nav-open"));
          return;
        }
        const open = app.classList.contains("sidebar-collapsed");
        applyDesktop(open);
        localStorage.setItem(STORAGE_KEY, open ? "open" : "closed");
      });

      document
        .querySelectorAll("[data-close]")
        .forEach((el) =>
          el.addEventListener("click", () => applyMobile(false)),
        );

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isMobile()) applyMobile(false);

        const el = e.target as HTMLElement | null;
        const typing = el?.closest(
          'input, textarea, select, [contenteditable="true"]',
        );
        if (e.key === "/" && !typing) {
          const target =
            document.querySelector<HTMLInputElement>("[data-search]") ??
            document.querySelector<HTMLInputElement>("[data-global-search]");
          if (target) {
            e.preventDefault();
            target.focus();
            target.select();
          }
        }
      });
    </script>
  </body>
</html>
